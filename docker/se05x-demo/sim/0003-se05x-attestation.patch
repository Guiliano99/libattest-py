+#[test]
+fn timestamp_increases_across_a_quick_restart() {
+    // Boot as tcp_server does: provision, then start the attestation clock.
+    let boot = || {
+        let mut host = T1Host::new();
+        host.store.start_attest_clock();
+        host
+    };
+    let mut before = boot();
+    let mut last = vec![];
+    for _ in 0..20 {
+        let ts = before.get_timestamp();
+        assert!(ts > last, "strictly increasing within a run");
+        last = ts;
+    }
+    drop(before); // power off, and on again at once
+    let mut after = boot();
+    let started = Instant::now();
+    let first = after.get_timestamp();
+    assert!(started.elapsed() < Duration::from_millis(500), "the start-up wait is not in GetTimestamp");
+    assert!(first > last, "before {} after {}", hex::encode(&last), hex::encode(&first));
+}
