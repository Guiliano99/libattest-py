+//! End-to-end tests of the applet 7.2 attested read, driven through
+//! `T1Responder::process_frame` over a provisioned store the way tcp_server
+//! serves it: plain, T=1 chained and inside Platform SCP03. Besides the
+//! signed command they cover origin tracking, the ECDH and FORBID_ALL policy
+//! checks, the strict request tags, INS routing and timestamp monotonicity
+//! across a restart. The signature check is written apart from the handler.
+//! Run with `--test-threads=1` like the rest of the suite: the applet
+//! personality and the SCP03 keys come from process env vars.
+
+use std::time::{Duration, Instant};
+
+use p256::ecdsa::signature::hazmat::PrehashVerifier;
+use p256::ecdsa::{Signature, VerifyingKey};
+use p256::elliptic_curve::sec1::ToEncodedPoint;
+use se050_sim::applet::AppletVersion;
+use se050_sim::handlers::attest::{self, ATTEST_KEY_ID, UNIQUE_ID};
+use se050_sim::object_store::types::SecureObject;
+use se050_sim::object_store::ObjectStore;
+use se050_sim::scp03::crypto;
+use se050_sim::scp03::keys::Scp03Config;
+use se050_sim::t1::{crc16_x25, T1Responder};
+use sha2::{Digest, Sha256};
+
+const KEY: [u8; 4] = [0x10, 0xAA, 0x00, 0x02];
+const KEY2: [u8; 4] = [0x10, 0xAA, 0x00, 0x03];
+const POLICY_FORBID_ALL: u32 = 0x2000_0000;
+const POLICY_ALLOW_ATTESTATION: u32 = 0x0000_8000;
+
+/// A T=1 host over one provisioned store (framing as in tests/scp03.rs).
+struct T1Host {
+    t1: T1Responder,
+    store: ObjectStore,
+    seq: u8,
+}
+
+impl T1Host {
+    fn new() -> Self {
+        let mut store = ObjectStore::new();
+        attest::provision(&mut store, b"attestation-test-seed");
+        Self { t1: T1Responder::new(0x5A), store, seq: 0 }
+    }
+
+    /// Send `apdu` in I-blocks of at most `block` bytes, with the M bit on
+    /// all but the last, and reassemble the response into (data, SW).
+    fn send_chained(&mut self, apdu: &[u8], block: usize) -> (Vec<u8>, u16) {
+        let parts: Vec<&[u8]> = apdu.chunks(block).collect();
+        let mut chunks = vec![];
+        for (i, part) in parts.iter().enumerate() {
+            let more = if i + 1 < parts.len() { 0x20 } else { 0x00 };
+            let mut frame = vec![0x5A, (self.seq << 6) | more, part.len() as u8];
+            frame.extend_from_slice(part);
+            let crc = crc16_x25(&frame);
+            frame.extend_from_slice(&[crc as u8, (crc >> 8) as u8]);
+            self.seq ^= 1;
+            chunks = self.t1.process_frame(&frame, &mut self.store);
+            if more != 0 {
+                assert_eq!(chunks[0][1] & 0xC0, 0x80, "a chained I-block is acknowledged with an R-block");
+            }
+        }
+        let mut out = vec![];
+        for pair in chunks.chunks(2) {
+            out.extend_from_slice(&pair[1][..pair[0][2] as usize]);
+        }
+        let sw = out.split_off(out.len() - 2);
+        (out, u16::from_be_bytes([sw[0], sw[1]]))
+    }
+
+    fn send(&mut self, apdu: &[u8]) -> (Vec<u8>, u16) {
+        self.send_chained(apdu, 254)
+    }
+
+    fn get_timestamp(&mut self) -> Vec<u8> {
+        let (body, sw) = self.send(&[0x80, 0x04, 0x00, 0x3D, 0x00]);
+        assert_eq!(sw, 0x9000);
+        parse(&body).remove(0).1
+    }
+}
+
+/// Send `ins` with `data` inside a Platform SCP03 session at full security
+/// level (C-MAC, C-DECRYPTION, R-MAC, R-ENCRYPTION): CLA 84, short Lc and an
+/// encrypted data field on the wire. Returns the decrypted response data and
+/// the SW. Uses the crate's SCP03 primitives, which tests/scp03.rs checks
+/// against an independent host.
+fn send_scp03(host: &mut T1Host, ins: u8, data: &[u8]) -> (Vec<u8>, u16) {
+    let keys = Scp03Config::from_env(AppletVersion::from_env());
+    let host_ch = [0xA0u8; 8];
+    let mut init = vec![0x80, 0x50, keys.kvn, 0x00, 0x08];
+    init.extend_from_slice(&host_ch);
+    init.push(0x00);
+    let (resp, sw) = host.send(&init);
+    assert_eq!(sw, 0x9000, "INITIALIZE UPDATE");
+    let card_ch: [u8; 8] = resp[13..21].try_into().unwrap();
+    let (s_enc, s_mac, s_rmac) =
+        crypto::derive_session_keys(&keys.enc, &keys.mac, &host_ch, &card_ch).unwrap();
+    let host_crypto = crypto::cryptogram(&s_mac, &host_ch, &card_ch, crypto::DDC_HOST_CRYPTOGRAM).unwrap();
+    let mut auth = vec![0x84, 0x82, 0x33, 0x00, 0x10];
+    auth.extend_from_slice(&host_crypto);
+    let mut mcv = crypto::cmac_chain(&s_mac, &[0; 16], &auth).unwrap();
+    auth.extend_from_slice(&mcv[..8]);
+    assert_eq!(host.send(&auth), (vec![], 0x9000), "EXTERNAL AUTHENTICATE");
+
+    // The first command of a session uses counter 1.
+    let icv = crypto::counter_icv(&s_enc, 1, false).unwrap();
+    let enc = crypto::cbc_crypt(&s_enc, &icv, &crypto::pad_m2(data), true).unwrap();
+    let mut wire = vec![0x84, ins, 0x00, 0x00, (enc.len() + 8) as u8];
+    wire.extend_from_slice(&enc);
+    mcv = crypto::cmac_chain(&s_mac, &mcv, &wire).unwrap();
+    wire.extend_from_slice(&mcv[..8]);
+    wire.push(0x00); // Le
+    let (resp, sw) = host.send(&wire);
+    if sw != 0x9000 {
+        return (resp, sw);
+    }
+    let (enc, rmac) = resp.split_at(resp.len() - 8);
+    let mut mac_in = enc.to_vec();
+    mac_in.extend_from_slice(&sw.to_be_bytes());
+    assert_eq!(crypto::cmac_chain(&s_rmac, &mcv, &mac_in).unwrap()[..8], *rmac, "R-MAC");
+    let icv = crypto::counter_icv(&s_enc, 1, true).unwrap();
+    let plain = crypto::cbc_crypt(&s_enc, &icv, enc, false).unwrap();
+    (crypto::unpad_m2(&plain).unwrap(), sw)
+}
+
+fn tlv(tag: u8, v: &[u8]) -> Vec<u8> {
+    let mut o = vec![tag, v.len() as u8];
+    o.extend_from_slice(v);
+    o
+}
+
+fn attest_data(obj: [u8; 4], key: [u8; 4], algo: u8, fresh: &[u8]) -> Vec<u8> {
+    [tlv(0x41, &obj), tlv(0x45, &key), tlv(0x46, &[algo]), tlv(0x47, fresh)].concat()
+}
+
+/// Extended Lc and extended Le 00 00, the way Plug & Trust frames an attested read.
+fn ext_apdu(ins: u8, p1: u8, p2: u8, data: &[u8]) -> Vec<u8> {
+    let mut a = vec![0x80, ins, p1, p2, 0x00, (data.len() >> 8) as u8, data.len() as u8];
+    a.extend_from_slice(data);
+    a.extend_from_slice(&[0x00, 0x00]);
+    a
+}
+
+/// What the SE hashes: the plain command with extended Lc, without Le.
+fn hashed_cmd(ins: u8, data: &[u8]) -> Vec<u8> {
+    let mut a = ext_apdu(ins, 0x00, 0x00, data);
+    a.truncate(a.len() - 2);
+    a
+}
+
+fn short_apdu(ins: u8, p1: u8, p2: u8, data: &[u8]) -> Vec<u8> {
+    let mut a = vec![0x80, ins, p1, p2, data.len() as u8];
+    a.extend_from_slice(data);
+    a
+}
+
+/// TLV parser for short, 0x81 and 0x82 lengths.
+fn parse(body: &[u8]) -> Vec<(u8, Vec<u8>)> {
+    let mut out = vec![];
+    let mut i = 0;
+    while i < body.len() {
+        let (len, hl) = match body[i + 1] {
+            0x81 => (body[i + 2] as usize, 3),
+            0x82 => (((body[i + 2] as usize) << 8) | body[i + 3] as usize, 4),
+            l => (l as usize, 2),
+        };
+        out.push((body[i], body[i + hl..i + hl + len].to_vec()));
+        i += hl + len;
+    }
+    out
+}
+
+fn tags(t: &[(u8, Vec<u8>)]) -> Vec<u8> {
+    t.iter().map(|(tag, _)| *tag).collect()
+}
+
+fn public_key(store: &ObjectStore, id: &[u8; 4]) -> Vec<u8> {
+    match store.get(id) {
+        Some(SecureObject::ECKeyPair { public_key, .. }) => public_key.clone(),
+        other => panic!("not an EC key pair: {other:?}"),
+    }
+}
+
+/// Check the ECDSA signature over SHA-256(SHA-256(cmd) || the response TLVs
+/// re-encoded with 0x82 lengths). Returns the signed TLVs, or None if the
+/// signature does not verify.
+fn verify256(att_pub: &[u8], cmd: &[u8], body: &[u8]) -> Option<Vec<(u8, Vec<u8>)>> {
+    let mut t = parse(body);
+    let (tag, sig) = t.pop()?;
+    assert_eq!(tag, 0x52, "the signature comes last");
+    let mut m = Sha256::digest(cmd).to_vec();
+    for (tag, v) in &t {
+        m.extend_from_slice(&[*tag, 0x82, (v.len() >> 8) as u8, v.len() as u8]);
+        m.extend_from_slice(v);
+    }
+    let vk = VerifyingKey::from_sec1_bytes(att_pub).unwrap();
+    vk.verify_prehash(&Sha256::digest(&m), &Signature::from_der(&sig).ok()?).ok()?;
+    Some(t)
+}
+
+/// Generate a P-256 key pair inside the SE, with an optional one-entry policy.
+fn gen_p256(host: &mut T1Host, id: [u8; 4], ar_header: Option<u32>) -> u16 {
+    let mut d = vec![];
+    if let Some(h) = ar_header {
+        let mut entry = vec![8, 0, 0, 0, 0];
+        entry.extend_from_slice(&h.to_be_bytes());
+        d.extend(tlv(0x11, &entry)); // TAG_POLICY
+    }
+    d.extend(tlv(0x41, &id));
+    d.extend(tlv(0x42, &[0x03])); // NIST P-256
+    host.send(&short_apdu(0x01, 0x61, 0x00, &d)).1
+}
+
+#[test]
+fn signature_covers_the_plain_command_on_every_transport() {
+    let mut host = T1Host::new();
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    let att_pub = public_key(&host.store, &ATTEST_KEY_ID);
+    let data = attest_data(KEY, ATTEST_KEY_ID, 0x21, &[0xA5; 16]);
+    let cmd = hashed_cmd(0x22, &data);
+    let mut short = short_apdu(0x22, 0, 0, &data);
+    short.push(0x00);
+
+    let answers = [
+        ("plain, one I-block", host.send(&ext_apdu(0x22, 0, 0, &data))),
+        ("plain, two chained I-blocks", host.send_chained(&ext_apdu(0x22, 0, 0, &data), 10)),
+        ("short Lc on the wire", host.send(&short)),
+        ("Platform SCP03, full level", send_scp03(&mut host, 0x22, &data)),
+    ];
+    for (name, (body, sw)) in answers {
+        assert_eq!(sw, 0x9000, "{name}");
+        let t = verify256(&att_pub, &cmd, &body).unwrap_or_else(|| panic!("{name}: signature"));
+        assert_eq!(tags(&t), [0x41, 0x42, 0x43, 0x44, 0x4F], "{name}");
+    }
+    // The short-Lc command is signed in its extended form, not as received.
+    let (body, _) = host.send(&short);
+    assert!(verify256(&att_pub, &short[..short.len() - 1], &body).is_none());
+}
+
+#[test]
+fn origin_follows_the_latest_key_value() {
+    let mut host = T1Host::new();
+    let att_pub = public_key(&host.store, &ATTEST_KEY_ID);
+    let data = attest_data(KEY, ATTEST_KEY_ID, 0x21, &[0x77; 16]);
+    let origin = |host: &mut T1Host| {
+        let (body, sw) = host.send(&ext_apdu(0x22, 0, 0, &data));
+        assert_eq!(sw, 0x9000);
+        let t = verify256(&att_pub, &hashed_cmd(0x22, &data), &body).expect("signature");
+        t[2].1[14] // attributes without a policy: the origin follows the RFU bytes
+    };
+
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    assert_eq!(origin(&mut host), 0x02, "generated inside the SE: INTERNAL");
+    let host_key = p256::ecdsa::SigningKey::from_slice(&[0x11; 32]).unwrap();
+    let host_pub = host_key.verifying_key().to_encoded_point(false).as_bytes().to_vec();
+    let import = [tlv(0x41, &KEY), tlv(0x42, &[0x03]), tlv(0x43, &[0x11; 32]), tlv(0x44, &host_pub)].concat();
+    assert_eq!(host.send(&short_apdu(0x01, 0x61, 0x00, &import)).1, 0x9000);
+    assert_eq!(origin(&mut host), 0x01, "host key imported over it: EXTERNAL");
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    assert_eq!(origin(&mut host), 0x02, "regenerated: INTERNAL again");
+}
+
+#[test]
+fn attestation_key_refuses_ecdh() {
+    let mut host = T1Host::new();
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    let peer = p256::SecretKey::from_slice(&[0x22; 32]).unwrap();
+    let peer_pub = peer.public_key().to_encoded_point(false).as_bytes().to_vec();
+    let ecdh = |key: [u8; 4]| short_apdu(0x03, 0x01, 0x0F, &[tlv(0x41, &key), tlv(0x42, &peer_pub)].concat());
+    assert_eq!(host.send(&ecdh(ATTEST_KEY_ID)).1, 0x6986, "no ALLOW_KA");
+    assert_eq!(host.send(&ecdh(KEY)).1, 0x9000, "no policy");
+}
+
+#[test]
+fn forbid_all_blocks_attestation() {
+    let mut host = T1Host::new();
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    assert_eq!(gen_p256(&mut host, KEY2, Some(POLICY_FORBID_ALL | POLICY_ALLOW_ATTESTATION)), 0x9000);
+    let read = |key| ext_apdu(0x22, 0, 0, &attest_data(KEY, key, 0x21, &[0x44; 16]));
+    assert_eq!(host.send(&read(KEY2)).1, 0x6982);
+    assert_eq!(host.send(&read(ATTEST_KEY_ID)).1, 0x9000);
+}
+
+#[test]
+fn request_takes_only_its_own_tags_once_and_16_byte_freshness() {
+    let mut host = T1Host::new();
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    let att_pub = public_key(&host.store, &ATTEST_KEY_ID);
+    let fresh = [0x01; 16];
+    let chip_read = |offset: Vec<u8>| {
+        [offset, tlv(0x43, &[0, 4]), tlv(0x45, &ATTEST_KEY_ID), tlv(0x46, &[0x21]), tlv(0x47, &fresh)].concat()
+    };
+    let refused = [
+        ("TAG_8", [attest_data(KEY, ATTEST_KEY_ID, 0x21, &fresh), tlv(0x48, &[0xEE; 32])].concat()),
+        ("TAG_2 twice", [tlv(0x41, &UNIQUE_ID), tlv(0x42, &[0, 2]), chip_read(tlv(0x42, &[0, 4]))].concat()),
+        ("15-byte freshness", attest_data(KEY, ATTEST_KEY_ID, 0x21, &[0x01; 15])),
+        ("32-byte freshness", attest_data(KEY, ATTEST_KEY_ID, 0x21, &[0x01; 32])),
+    ];
+    for (name, d) in refused {
+        assert_eq!(host.send(&ext_apdu(0x22, 0, 0, &d)).1, 0x6A80, "{name}");
+    }
+    // Offset and length, each once, are part of the request format.
+    let ok = [tlv(0x41, &UNIQUE_ID), chip_read(tlv(0x42, &[0, 2]))].concat();
+    let (body, sw) = host.send(&ext_apdu(0x22, 0, 0, &ok));
+    assert_eq!(sw, 0x9000);
+    let t = verify256(&att_pub, &hashed_cmd(0x22, &ok), &body).expect("signature");
+    assert_eq!(t[0].1.len(), 4);
+}
+
+#[test]
+fn attest_bit_is_never_downgraded_to_a_plain_read() {
+    let mut host = T1Host::new();
+    assert_eq!(gen_p256(&mut host, KEY, None), 0x9000);
+    let att_pub = public_key(&host.store, &ATTEST_KEY_ID);
+    let data = attest_data(KEY, ATTEST_KEY_ID, 0x21, &[0x33; 16]);
+    // READ | ATTEST, alone or with the TRANSIENT and AUTH bits: attested,
+    // and the INS as received is what the SE hashes.
+    for ins in [0x22u8, 0x62, 0xA2, 0xE2] {
+        let (body, sw) = host.send(&ext_apdu(ins, 0, 0, &data));
+        assert_eq!(sw, 0x9000, "INS {ins:02X}");
+        let t = verify256(&att_pub, &hashed_cmd(ins, &data), &body).expect("signature");
+        assert_eq!(tags(&t), [0x41, 0x42, 0x43, 0x44, 0x4F], "INS {ins:02X}");
+    }
+    // Other INS with the attest bit, and attested reads with another P1 or
+    // P2 (e.g. attested ReadObjectAttributes): refused, not answered plain.
+    for (ins, p1, p2) in [(0x21u8, 0x00u8, 0x00u8), (0x23, 0x00, 0x00), (0x24, 0x00, 0x00), (0x22, 0x00, 0x3B), (0x22, 0x01, 0x00)] {
+        assert_eq!(host.send(&ext_apdu(ins, p1, p2, &data)), (vec![], 0x6A86), "INS {ins:02X} P1 {p1:02X} P2 {p2:02X}");
+    }
+    // Plain ReadObject and ReadObjectAttributes are unchanged.
+    assert_eq!(host.send(&short_apdu(0x02, 0, 0, &tlv(0x41, &KEY))).1, 0x9000);
+    assert_eq!(host.send(&short_apdu(0x02, 0, 0x3B, &tlv(0x41, &KEY))).1, 0x9000);
+}
