+//! Applet 7.2 attested ReadObject (INS_READ | INS_ATTEST = 0x22) and
+//! GetTimestamp, plus the trust-provisioned attestation key and chip
+//! unique ID they need.
+//!
+//! Layout follows NXP Plug & Trust v04.08.00:
+//! Se05x_API_ReadObject_W_Attst_V2 (se05x_APDU_impl.h) for the request and
+//! response, nxECKey_VerifyAttestation (fsl_sss_se05x_apis.c) for the
+//! signed data, and AN13254 Rev 1.1 section 3.1. Only the applet 7.2
+//! format exists here; the 3.1.1 personality refuses the attested read
+//! rather than emit the legacy AN12413 Table 106 format, and answers
+//! GetTimestamp like every other personality.
+
+use crate::apdu::*;
+use crate::object_store::types::{ECCurve, SecureObject};
+use crate::object_store::ObjectStore;
+use crate::policy::{POLICY_OBJ_ALLOW_ATTESTATION, POLICY_OBJ_ALLOW_READ};
+use crate::tlv::{self, Tlv, TAG_1, TAG_2, TAG_3, TAG_4, TAG_5, TAG_6, TAG_7, TAG_SIGNATURE, TAG_TIMESTAMP};
+use ecdsa::signature::hazmat::PrehashSigner;
+use sha2::{Digest, Sha256};
+
+/// SSS_SE05X_RESID_ATTESTATION_KEY (fsl_sss_se05x_apis.c).
+pub const ATTEST_KEY_ID: [u8; 4] = [0xF0, 0x00, 0x00, 0x12];
+/// kSE05x_AppletResID_UNIQUE_ID (se05x_enums.h), 18 bytes (se05x_const.h).
+pub const UNIQUE_ID: [u8; 4] = [0x7F, 0xFF, 0x02, 0x06];
+pub const ORIGIN_PROVISIONED: u8 = 0x03;
+
+/// One policy entry: length 8 | authObjectId 0 (any session) | AR header.
+fn policy_entry(ar_header: u32) -> Vec<u8> {
+    let mut entry = vec![8, 0, 0, 0, 0];
+    entry.extend_from_slice(&ar_header.to_be_bytes());
+    entry
+}
+
+/// Trust-provision the P-256 attestation key (policy "Anybody Read and
+/// Attestation" per AN12436: READ | ATTESTATION, no SIGN, no DEC) and the
+/// chip unique ID. Both derive from `seed`: the same seed gives the same
+/// key. tcp_server passes SE050_SIM_ATTEST_SEED when it is set and 32 bytes
+/// of OS randomness otherwise, so by default every start is a new chip
+/// whose key nobody else can derive. A real SE05x attestation key is
+/// individual per die and never leaves it.
+/// Neither policy grants WRITE or DELETE, and DeleteAll keeps objects of
+/// origin ORIGIN_PROVISIONED, so both stay for the life of the store.
+pub fn provision(store: &mut ObjectStore, seed: &[u8]) {
+    let key = (0u8..=255)
+        .find_map(|ctr| {
+            let d = Sha256::new()
+                .chain_update(b"SE050Sim attestation key v1")
+                .chain_update(seed)
+                .chain_update([ctr])
+                .finalize();
+            p256::ecdsa::SigningKey::from_slice(&d).ok()
+        })
+        .expect("SHA-256 output is a valid P-256 scalar with overwhelming probability");
+    store.insert(ATTEST_KEY_ID, SecureObject::ECKeyPair {
+        curve: ECCurve::NistP256,
+        private_key: key.to_bytes().to_vec(),
+        public_key: key.verifying_key().to_encoded_point(false).as_bytes().to_vec(),
+    });
+    store.set_creation_metadata(
+        ATTEST_KEY_ID,
+        Some(policy_entry(POLICY_OBJ_ALLOW_READ | POLICY_OBJ_ALLOW_ATTESTATION)),
+        ORIGIN_PROVISIONED,
+    );
+
+    let chip_id = Sha256::new().chain_update(b"SE050Sim chip id v1").chain_update(seed).finalize();
+    store.insert(UNIQUE_ID, SecureObject::Binary { data: chip_id[..18].to_vec() });
+    store.set_creation_metadata(UNIQUE_ID, Some(policy_entry(POLICY_OBJ_ALLOW_READ)), ORIGIN_PROVISIONED);
+}
+
+/// GetTimestamp (80 04 00 3D): TLV[TAG_1] with the 12-byte timestamp
+/// (AN12413 4.19.2).
+pub fn handle_get_timestamp(store: &mut ObjectStore, _v7: bool) -> ApduResponse {
+    // AN12413 (applets 3.1.0/3.1.1/3.6.0) specifies GetTimestamp, so 3.1.1 answers it too.
+    ApduResponse::success_with_tlvs(&[Tlv::new(TAG_1, &store.attest_timestamp())])
+}
+
+/// The value of the only TLV with `tag`; None if it is absent or repeated.
+fn single(tlvs: &[Tlv], tag: u8) -> Option<&[u8]> {
+    match tlv::find_tlvs(tlvs, tag)[..] {
+        [t] => Some(&t.value),
+        _ => None,
+    }
+}
+
+/// Attested ReadObject, applet 7.2 ("_V2") format.
+///
+/// Request: TAG_1 objId, [TAG_2 offset, TAG_3 length], TAG_5 attestation
+/// key id, TAG_6 AttestationAlgo, TAG_7 16-byte freshness.
+/// Response: [TAG_1 value] TAG_2 chip id, TAG_3 attributes, TAG_4 size,
+/// 0x4F timestamp, 0x52 DER signature over
+/// H(H(cmd) || the five TLVs with 0x82 hi lo lengths), where cmd is the
+/// plain command without Le, rebuilt with an extended Lc. The five TLVs go
+/// out in that same 0x82 form, so the wire bytes are the signed bytes.
+pub fn handle_read_attested(apdu: &ParsedApdu, store: &mut ObjectStore, v7: bool) -> ApduResponse {
+    if !v7 {
+        return ApduResponse::error(SW_CONDITIONS_NOT_SATISFIED);
+    }
+    // ponytail: ReadObject only. Attested ReadObjectAttributes (P2 0x3B) and
+    // ReadRSA_W_Attst (TAG_4) are refused, never answered unattested.
+    if apdu.p1 != P1_DEFAULT || apdu.p2 != P2_DEFAULT {
+        return ApduResponse::error(SW_WRONG_P1P2);
+    }
+    let Ok(tlvs) = apdu.parse_tlvs() else {
+        return ApduResponse::error(SW_WRONG_DATA);
+    };
+    let id = |tag| single(&tlvs, tag).and_then(|v| <[u8; 4]>::try_from(v).ok());
+    let (Some(obj_id), Some(att_id), Some(&[algo]), Some(fresh)) =
+        (id(TAG_1), id(TAG_5), single(&tlvs, TAG_6), single(&tlvs, TAG_7))
+    else {
+        return ApduResponse::error(SW_WRONG_DATA);
+    };
+    // AN12413 3.2.7.2: a 16-byte freshness; wolfSSL accepts only 16.
+    // Only the ReadObject_W_Attst_V2 tags, each at most once (this also
+    // refuses TAG_4, ReadRSA_W_Attst).
+    let allowed = [TAG_1, TAG_2, TAG_3, TAG_5, TAG_6, TAG_7];
+    if fresh.len() != 16
+        || tlvs.iter().enumerate().any(|(i, t)| {
+            !allowed.contains(&t.tag) || tlvs[..i].iter().any(|u| u.tag == t.tag)
+        })
+    {
+        return ApduResponse::error(SW_WRONG_DATA);
+    }
+
+    let Some(target) = store.get(&obj_id).cloned() else {
+        return ApduResponse::error(SW_CONDITIONS_NOT_SATISFIED);
+    };
+    // ponytail: P-256 attestation keys only.
+    let Some(SecureObject::ECKeyPair { curve: ECCurve::NistP256, private_key, .. }) =
+        store.get(&att_id).cloned()
+    else {
+        return ApduResponse::error(SW_CONDITIONS_NOT_SATISFIED);
+    };
+    // The applet default policy excludes ALLOW_ATTESTATION (AN12413
+    // Table 13), so it must be granted explicitly; policy_allows() would
+    // say yes for a key without a policy.
+    let may_attest = store
+        .metadata(&att_id)
+        .and_then(|m| m.policy.as_deref())
+        .and_then(crate::policy::ar_header_union)
+        .is_some_and(|h| {
+            h & POLICY_OBJ_ALLOW_ATTESTATION != 0 && h & crate::policy::POLICY_OBJ_FORBID_ALL == 0
+        });
+    if !may_attest {
+        return ApduResponse::error(SW_SECURITY_STATUS); // AN12413 3.2.7.2
+    }
+    // ECSignatureAlgo -> digest mode; SHA-224..512 as in AN13254 Table 2.
+    let mode = match algo {
+        0x25 => 0x07,
+        0x21 => 0x04,
+        0x22 => 0x05,
+        0x26 => 0x06,
+        _ => return ApduResponse::error(SW_WRONG_DATA),
+    };
+
+    // TAG_1 is whatever a plain ReadObject returns (READ policy, offset
+    // and length, symmetric keys never exported). A value the policy
+    // refuses is left out and the rest is still signed (P&T
+    // se05x_APDU_impl.h: "Keys with no read policy will not return TAG1";
+    // AN13254 p.7: attributes are always signed and returned).
+    let plain = super::object_mgmt::handle_read_object(apdu, store);
+    let value = match plain.sw {
+        SW_NO_ERROR => tlv::parse_tlvs(&plain.data).ok().and_then(|t| t.into_iter().next()).map(|t| t.value),
+        SW_COMMAND_NOT_ALLOWED => None,
+        sw => return ApduResponse::error(sw),
+    };
+    let Some(SecureObject::Binary { data: chip_id }) = store.get(&UNIQUE_ID).cloned() else {
+        return ApduResponse::error(SW_CONDITIONS_NOT_SATISFIED);
+    };
+    let attributes = super::object_mgmt::object_attributes(store, &obj_id, &target);
+    let size = (target.data_size() as u16).to_be_bytes();
+    let timestamp = store.attest_timestamp();
+
+    let n = apdu.data.len();
+    let mut cmd = vec![apdu.cla & !0x04, apdu.ins, apdu.p1, apdu.p2, 0x00, (n >> 8) as u8, n as u8];
+    cmd.extend_from_slice(&apdu.data);
+
+    let fields = [
+        (TAG_2, &chip_id[..]),
+        (TAG_3, &attributes[..]),
+        (TAG_4, &size[..]),
+        (TAG_TIMESTAMP, &timestamp[..]),
+    ];
+    let mut body = Vec::new();
+    for (tag, v) in value.iter().map(|v| (TAG_1, &v[..])).chain(fields) {
+        body.extend_from_slice(&[tag, 0x82, (v.len() >> 8) as u8, v.len() as u8]);
+        body.extend_from_slice(v);
+    }
+    let hash = |d: &[u8]| super::digest::compute_hash(mode, d).expect("mode is one of the four above");
+    let mut signed = hash(&cmd);
+    signed.extend_from_slice(&body);
+
+    let Ok(key) = p256::ecdsa::SigningKey::from_slice(&private_key) else {
+        return ApduResponse::error(SW_CONDITIONS_NOT_SATISFIED);
+    };
+    let sig: Result<p256::ecdsa::Signature, _> = key.sign_prehash(&hash(&signed));
+    let Ok(sig) = sig else {
+        return ApduResponse::error(SW_CONDITIONS_NOT_SATISFIED);
+    };
+    body.extend_from_slice(&Tlv::new(TAG_SIGNATURE, sig.to_der().as_bytes()).encode());
+    ApduResponse::success_with_data(body)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::applet::AppletVersion;
+    use crate::handlers::{ec, object_mgmt};
+    use crate::policy::{POLICY_OBJ_ALLOW_DELETE, POLICY_OBJ_ALLOW_SIGN};
+    use crate::tlv::TAG_POLICY;
+    use ecdsa::signature::hazmat::PrehashVerifier;
+    use sha2::Sha384;
+
+    const KEY: [u8; 4] = [0x10, 0xAA, 0x00, 0x02];
+
+    fn apdu(ins: u8, p1: u8, p2: u8, data: Vec<u8>) -> ParsedApdu {
+        ParsedApdu { cla: 0x80, ins, p1, p2, data, le: None }
+    }
+
+    fn attested(obj: [u8; 4], key: [u8; 4], algo: u8, fresh: &[u8]) -> ParsedApdu {
+        let mut d = vec![TAG_1, 4];
+        d.extend_from_slice(&obj);
+        d.extend_from_slice(&[TAG_5, 4]);
+        d.extend_from_slice(&key);
+        d.extend_from_slice(&[TAG_6, 1, algo, TAG_7, fresh.len() as u8]);
+        d.extend_from_slice(fresh);
+        apdu(INS_READ | INS_ATTEST, P1_DEFAULT, P2_DEFAULT, d)
+    }
+
+    /// A provisioned store plus a P-256 key generated inside it at KEY.
+    fn store_with_key(policy: Option<u32>) -> ObjectStore {
+        let mut store = ObjectStore::new();
+        provision(&mut store, b"unit-test-seed");
+        let mut d = vec![];
+        if let Some(h) = policy {
+            d.extend_from_slice(&[TAG_POLICY, 9]);
+            d.extend_from_slice(&policy_entry(h));
+        }
+        d.extend_from_slice(&[TAG_1, 4]);
+        d.extend_from_slice(&KEY);
+        d.extend_from_slice(&[TAG_2, 1, 0x03]); // NIST P-256
+        let keygen = apdu(INS_WRITE, P1_EC | P1_KEY_PAIR, P2_DEFAULT, d);
+        assert_eq!(ec::handle_write_ec_key(&keygen, &mut store, AppletVersion::V7_2_0).sw, SW_NO_ERROR);
+        store
+    }
+
+    fn public_key(store: &ObjectStore, id: &[u8; 4]) -> Vec<u8> {
+        match store.get(id) {
+            Some(SecureObject::ECKeyPair { public_key, .. }) => public_key.clone(),
+            _ => panic!("no EC key pair"),
+        }
+    }
+
+    fn chip_id(store: &ObjectStore) -> Vec<u8> {
+        match store.get(&UNIQUE_ID) {
+            Some(SecureObject::Binary { data }) => data.clone(),
+            _ => panic!("no chip id"),
+        }
+    }
+
+    /// Verifier side, written apart from the handler: rebuild
+    /// H(cmd) || TLVs with 0x82 lengths and check the DER signature.
+    /// Returns the signed TLVs.
+    fn verify(store: &ObjectStore, req: &ParsedApdu, body: &[u8], algo: u8) -> Vec<Tlv> {
+        let mut tlvs = tlv::parse_tlvs(body).unwrap();
+        let sig = tlvs.pop().unwrap();
+        assert_eq!(sig.tag, TAG_SIGNATURE);
+        let mut cmd = vec![0x80, 0x22, 0x00, 0x00, 0x00, 0x00, req.data.len() as u8];
+        cmd.extend_from_slice(&req.data);
+        let hash = |d: &[u8]| match algo {
+            0x21 => Sha256::digest(d).to_vec(),
+            0x22 => Sha384::digest(d).to_vec(),
+            _ => unreachable!(),
+        };
+        let mut m = hash(&cmd);
+        for t in &tlvs {
+            m.extend_from_slice(&[t.tag, 0x82, 0x00, t.value.len() as u8]);
+            m.extend_from_slice(&t.value);
+        }
+        let vk = p256::ecdsa::VerifyingKey::from_sec1_bytes(&public_key(store, &ATTEST_KEY_ID)).unwrap();
+        let sig = p256::ecdsa::Signature::from_der(&sig.value).unwrap();
+        vk.verify_prehash(&hash(&m), &sig).expect("attestation signature verifies");
+        tlvs
+    }
+
+    #[test]
+    fn test_attested_read_signature_verifies() {
+        let mut store = store_with_key(None);
+        for algo in [0x21, 0x22] {
+            let req = attested(KEY, ATTEST_KEY_ID, algo, &[0xA5; 16]);
+            let resp = handle_read_attested(&req, &mut store, true);
+            assert_eq!(resp.sw, SW_NO_ERROR);
+            assert_eq!(resp.data[1], 0x82, "signed TLVs go out in the 0x82 form");
+            let tlvs = verify(&store, &req, &resp.data, algo);
+            let tags: Vec<u8> = tlvs.iter().map(|t| t.tag).collect();
+            assert_eq!(tags, [TAG_1, TAG_2, TAG_3, TAG_4, TAG_TIMESTAMP]);
+            assert_eq!(tlvs[0].value, public_key(&store, &KEY));
+            assert_eq!(tlvs[1].value, chip_id(&store));
+            let attrs = &tlvs[2].value;
+            assert_eq!(attrs, &object_mgmt::object_attributes(&store, &KEY, store.get(&KEY).unwrap()));
+            assert_eq!(&attrs[..5], &[0x10, 0xAA, 0x00, 0x02, 0x29]);
+            assert_eq!(attrs[14], 0x02, "no policy, then origin INTERNAL");
+            assert_eq!(tlvs[3].value, [0x00, 0x20]);
+            assert_eq!(tlvs[4].value.len(), 12);
+        }
+    }
+
+    #[test]
+    fn test_policy_and_request_refusals() {
+        let mut store = store_with_key(None);
+        // A key without an explicit ALLOW_ATTESTATION (here: no policy) cannot attest.
+        let resp = handle_read_attested(&attested(KEY, KEY, 0x21, &[1; 16]), &mut store, true);
+        assert_eq!(resp.sw, SW_SECURITY_STATUS);
+
+        // The attestation key cannot sign host data (no ALLOW_SIGN) ...
+        let mut d = vec![TAG_1, 4];
+        d.extend_from_slice(&ATTEST_KEY_ID);
+        d.extend_from_slice(&[TAG_2, 1, 0x21, TAG_3, 32]);
+        d.extend_from_slice(&[0x55; 32]);
+        let sign = apdu(INS_CRYPTO, P1_SIGNATURE, P2_SIGN, d.clone());
+        assert_eq!(ec::handle_sign(&sign, &mut store).sw, SW_COMMAND_NOT_ALLOWED);
+        // ... while a key without a policy still signs.
+        d[2..6].copy_from_slice(&KEY);
+        let sign = apdu(INS_CRYPTO, P1_SIGNATURE, P2_SIGN, d);
+        assert_eq!(ec::handle_sign(&sign, &mut store).sw, SW_NO_ERROR);
+
+        for fresh in [&[0u8; 15][..], &[0u8; 17][..]] {
+            let req = attested(KEY, ATTEST_KEY_ID, 0x21, fresh);
+            assert_eq!(handle_read_attested(&req, &mut store, true).sw, SW_WRONG_DATA);
+        }
+        let req = attested(KEY, ATTEST_KEY_ID, 0x11, &[0; 16]); // SHA-1
+        assert_eq!(handle_read_attested(&req, &mut store, true).sw, SW_WRONG_DATA);
+        let mut req = attested(KEY, ATTEST_KEY_ID, 0x21, &[0; 16]);
+        req.p2 = P2_ATTRIBUTES; // attested ReadObjectAttributes: refused, not downgraded
+        assert_eq!(handle_read_attested(&req, &mut store, true).sw, SW_WRONG_P1P2);
+    }
+
+    #[test]
+    fn test_timestamp_monotonic() {
+        let mut store = store_with_key(None);
+        let get = |store: &mut ObjectStore| {
+            let resp = handle_get_timestamp(store, true);
+            assert_eq!(resp.sw, SW_NO_ERROR);
+            tlv::parse_tlvs(&resp.data).unwrap().remove(0).value
+        };
+        let t1 = get(&mut store);
+        let t2 = get(&mut store);
+        let resp = handle_read_attested(&attested(KEY, ATTEST_KEY_ID, 0x21, &[2; 16]), &mut store, true);
+        let t3 = tlv::find_tlv(&tlv::parse_tlvs(&resp.data).unwrap(), TAG_TIMESTAMP).unwrap().value.clone();
+        assert_eq!(t1.len(), 12);
+        // Equal-length big-endian byte strings compare like the numbers.
+        assert!(t1 < t2 && t2 < t3, "{t1:02x?} {t2:02x?} {t3:02x?}");
+        assert_eq!(t1[..4], t3[..4], "persistent part fixed within one power cycle");
+    }
+
+    #[test]
+    fn test_provisioned_objects_survive_delete_all_and_refuse_changes() {
+        let mut store = store_with_key(None);
+        let (key, chip) = (public_key(&store, &ATTEST_KEY_ID), chip_id(&store));
+        assert_eq!(chip.len(), 18);
+        let mut again = ObjectStore::new();
+        provision(&mut again, b"unit-test-seed");
+        assert_eq!(public_key(&again, &ATTEST_KEY_ID), key, "same seed, same key");
+        let mut other = ObjectStore::new();
+        provision(&mut other, b"other-seed");
+        assert_ne!(public_key(&other, &ATTEST_KEY_ID), key);
+
+        for id in [ATTEST_KEY_ID, UNIQUE_ID] {
+            let mut d = vec![TAG_1, 4];
+            d.extend_from_slice(&id);
+            let delete = apdu(INS_MGMT, P1_DEFAULT, P2_DELETE_OBJECT, d);
+            assert_eq!(object_mgmt::handle_mgmt(&delete, &mut store).sw, SW_CONDITIONS_NOT_SATISFIED);
+        }
+        let mut d = vec![TAG_1, 4];
+        d.extend_from_slice(&UNIQUE_ID);
+        d.extend_from_slice(&[TAG_4, 1, 0xFF]);
+        let write = apdu(INS_WRITE, P1_BINARY, P2_DEFAULT, d);
+        assert_eq!(object_mgmt::handle_write(&write, &mut store).sw, SW_CONDITIONS_NOT_SATISFIED);
+
+        store.clear(); // DeleteAll
+        assert_eq!(public_key(&store, &ATTEST_KEY_ID), key);
+        assert_eq!(chip_id(&store), chip);
+        assert_eq!(store.metadata(&ATTEST_KEY_ID).unwrap().origin, ORIGIN_PROVISIONED);
+        assert!(!store.exists(&KEY));
+    }
+
+    #[test]
+    fn test_v311_refuses_attested_read_but_answers_timestamp() {
+        let mut store = store_with_key(None);
+        let req = attested(KEY, ATTEST_KEY_ID, 0x21, &[3; 16]);
+        assert_eq!(handle_read_attested(&req, &mut store, false).sw, SW_CONDITIONS_NOT_SATISFIED);
+        // AN12413 (applets 3.x) specifies GetTimestamp too.
+        assert_eq!(handle_get_timestamp(&mut store, false).sw, SW_NO_ERROR);
+    }
+
+    #[test]
+    fn test_tag1_omitted_when_target_lacks_allow_read() {
+        let mut store = store_with_key(Some(POLICY_OBJ_ALLOW_SIGN | POLICY_OBJ_ALLOW_DELETE));
+        let req = attested(KEY, ATTEST_KEY_ID, 0x21, &[4; 16]);
+        let resp = handle_read_attested(&req, &mut store, true);
+        assert_eq!(resp.sw, SW_NO_ERROR);
+        let tags: Vec<u8> = verify(&store, &req, &resp.data, 0x21).iter().map(|t| t.tag).collect();
+        assert_eq!(tags, [TAG_2, TAG_3, TAG_4, TAG_TIMESTAMP]);
+    }
+}
