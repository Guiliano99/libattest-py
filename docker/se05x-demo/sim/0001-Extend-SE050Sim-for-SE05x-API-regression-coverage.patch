+    valid = 1;
+    if (ret == 0) {
+        ret = wc_se050_verify_attestation(&result,
+            client_keypub_der_2048, sizeof_client_keypub_der_2048,
+            wrongRandom, sizeof(wrongRandom), &valid);
+        if ((ret != 0) || valid) {
+            ret = fail("replayed attestation accepted", ret);
+        }
+    }
+
+    if (rngInit) {
+        wc_FreeRng(&rng);
+    }
+    if (keyInit) {
+        wc_FreeRsaKey(&key);
+    }
+    return ret;
+}
